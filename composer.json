{
    "name": "peters-development/laravel-model-logger",
    "description": "Lightweight polymorphic model activity logging for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peters Development",
            "email": "info@petersdevelopment.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "PetersDevelopment\\ModelLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PetersDevelopment\\ModelLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "PetersDevelopment\\ModelLogger\\ModelLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
